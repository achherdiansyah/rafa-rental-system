APP_NAME="RAFA Rental System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database - MySQL 8.4 (Source of Truth)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rafa_rental
DB_USERNAME=rafa
DB_PASSWORD=rafa_password

# Session & Cache using database (No Redis on cPanel)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Queue using database (No Redis/Horizon on cPanel)
QUEUE_CONNECTION=database

# Local file storage (No MinIO on cPanel)
FILESYSTEM_DISK=public

# Mail Driver
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@rafarental.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173