# RAFA Rental System — production environment template (cPanel)
# Copy to backend/.env, then: php artisan key:generate
APP_NAME="RAFA Rental System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://demo.domain.com

# Frontend (built with Node at build-time only; NOT required at runtime)
FRONTEND_URL=https://admin.domain.com
CORS_ALLOWED_ORIGINS=https://admin.domain.com

# Trust HTTPS proxy (cPanel behind AutoSSL / ProxyPass)
TRUSTED_PROXIES=*

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SANCTUM_EXPIRATION=10080

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Optional WhatsApp provider class (leave empty to keep deliveries SKIPPED)
WHATSAPP_PROVIDER=
WHATSAPP_QUEUE=false

MAIL_MAILER=log